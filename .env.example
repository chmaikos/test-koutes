# ------------------------------------------------------------------
# Warehouse Box Tracker - environment configuration
# Copy to `.env` and fill in real values before `docker compose up`.
# ------------------------------------------------------------------

# --- Postgres ------------------------------------------------------
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- API -----------------------------------------------------------
# Comma-separated list of origins allowed by CORS (only relevant if you
# bypass the bundled Nginx reverse proxy during development).
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_PORT=8000
API_LOG_LEVEL=info

# --- Microsoft Entra ID (M365 SSO) --------------------------------
# Tenant ID (GUID) of your Microsoft 365 / Entra ID tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the Entra app registration that exposes
# the API and is used by the SPA.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret for the same app registration. Used by the API for
# Microsoft Graph (sendMail) via the client-credentials flow.
ENTRA_CLIENT_SECRET=replace-with-secret

# Audience the API accepts in incoming access tokens. Must match the
# "Application ID URI" / scope on the app registration.
# Example: api://00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# --- Local (break-glass) admin -----------------------------------
# A built-in local admin always exists so you can sign in even if M365 SSO
# is unavailable. The very first login forces a username + password change.
#
# Generate a strong secret, e.g.: `openssl rand -base64 48`.
# If left empty, the local login endpoint returns 503 (disabled).
LOCAL_JWT_SECRET=replace-with-long-random-secret
LOCAL_JWT_TTL_MINUTES=480

# Defaults that the API provisions on first startup. They MUST be changed on
# the first local login. Pick something meaningful for *your* deployment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# --- Alerts --------------------------------------------------------
# Service mailbox the API will send alert emails *from* via Graph.
# The app registration needs Mail.Send (Application) on this mailbox.
ALERT_EMAIL_FROM=warehouse-alerts@example.com
# Comma-separated fallback recipients used when no users with the right
# warehouse ACL have email_alerts_enabled. Set to a monitored shared
# inbox or distribution list. Per-warehouse routing is preferred.
ALERT_EMAIL_TO=ops@example.com

# Public base URL of the SPA -- used to build deep-links from alert emails
# back into the app. Leave empty to suppress the CTA button (e.g. in dev or
# when the recipient's network can't reach the app).
PUBLIC_BASE_URL=https://warehouse.example.com

# Reminder cadence: how long an alert can stay unresolved before the
# dispatcher sends a follow-up email to the same recipients. 0 disables.
ALERT_REMINDER_HOURS=24
# Escalation: how long an alert can stay open before the dispatcher
# forwards it to admins. Sent at most once per alert. 0 disables.
ALERT_ESCALATION_HOURS=48

# Leading-indicator thresholds for the "near_*" alert types.
# near_capacity fires once inventory crosses this percentage of max but
# stays under the hard cap. near_low_inventory fires once inventory is
# within this many boxes of the minimum but still above it.
NEAR_CAPACITY_PERCENT=90
NEAR_LOW_INVENTORY_BUFFER=10
# A box still in 'received' state after this many days is considered stuck.
# 0 disables the box_stuck trigger entirely.
BOX_STUCK_THRESHOLD_DAYS=30

# --- Productivity --------------------------------------------------
# Local timezone for "daily" productivity boundaries (today's date,
# end-of-day report). Use any IANA zone name; falls back to UTC if the
# zone isn't installed.
APP_TIMEZONE=UTC
# Hour of day (0-23, in APP_TIMEZONE) at which the per-warehouse
# productivity report email is sent. Recipients are the same as for
# warehouse alerts (per-warehouse ACL + admins).
PRODUCTIVITY_REPORT_HOUR=18
# Set to true to send a "0 pages today" report for warehouses with no
# entries. Default false: only warehouses that logged something get a
# report so empty buildings don't spam the recipients.
PRODUCTIVITY_REPORT_INCLUDE_EMPTY=false

# --- Web (build-time) ---------------------------------------------
# These are baked into the SPA bundle at build time.
WEB_PORT=8080
VITE_ENTRA_TENANT_ID=${ENTRA_TENANT_ID}
VITE_ENTRA_CLIENT_ID=${ENTRA_CLIENT_ID}
VITE_API_SCOPE=${ENTRA_API_AUDIENCE}/access_as_user
VITE_API_BASE_URL=/api
