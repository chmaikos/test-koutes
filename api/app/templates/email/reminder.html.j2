{% extends "_base.html.j2" %}

{% block notice %}
<tr>
  <td style="padding:16px 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;">
      <tr>
        <td style="padding:12px 16px;font-size:13px;color:#9a3412;">
          This alert is still open.
          {% if acknowledged_by %}
            Acknowledged by
            <strong>{{ acknowledged_by.display_name }}</strong>
            ({{ acknowledged_by.email }})
            on {{ alert.acknowledged_at | shortdt }} but the underlying
            condition has not cleared yet.
          {% else %}
            No-one has acknowledged it yet.
          {% endif %}
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endblock %}
