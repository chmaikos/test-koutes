<!doctype html>
<html>
  <body style="margin:0;background:#f8fafc;font-family:Arial,sans-serif;color:#1e293b">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr><td align="center" style="padding:24px">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0"
               style="max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:10px">
          <tr><td style="padding:20px 24px;border-bottom:4px solid {{ accent }}">
            <div style="font-size:12px;text-transform:uppercase;color:#64748b">Request #{{ request_id }} · {{ warehouse_name }}</div>
            <h1 style="font-size:22px;margin:8px 0 0">{{ headline }}</h1>
          </td></tr>
          <tr><td style="padding:24px">
            <p style="margin:0 0 16px;line-height:1.5">{{ message }}</p>
            <table role="presentation" width="100%" style="background:#f8fafc;border-radius:8px">
              <tr>
                <td style="padding:12px"><strong>Status</strong><br>{{ status }}</td>
                <td style="padding:12px"><strong>Priority</strong><br>{{ priority }}</td>
                <td style="padding:12px"><strong>Assigned</strong><br>{{ assigned_to }}</td>
              </tr>
            </table>
            {% if deep_link %}
            <p style="margin:20px 0 0">
              <a href="{{ deep_link }}" style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;padding:10px 16px;border-radius:6px">Open request</a>
            </p>
            {% endif %}
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
