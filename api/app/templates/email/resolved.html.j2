{% extends "_base.html.j2" %}

{% block notice %}
<tr>
  <td style="padding:16px 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#ecfdf5;border:1px solid #bbf7d0;border-radius:8px;">
      <tr>
        <td style="padding:12px 16px;font-size:13px;color:#065f46;">
          The condition has cleared as of
          {{ alert.resolved_at | shortdt }}. No further action is required;
          this email is the final word on this alert.
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endblock %}

{% block action_text %}
The alert has resolved. You can close any tickets you opened against it.
{% endblock %}
