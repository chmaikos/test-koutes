{% extends "_base.html.j2" %}

{% block notice %}
<tr>
  <td style="padding:16px 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;">
      <tr>
        <td style="padding:12px 16px;font-size:13px;color:#7f1d1d;">
          This alert has been open for an extended period without
          {% if acknowledged_by %}being resolved{% else %}being acknowledged{% endif %}.
          You are receiving it because the primary recipients did not act in time.
          Please follow up directly.
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endblock %}
